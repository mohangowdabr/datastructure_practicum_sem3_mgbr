Bubble Sort
#include <iostream>
using namespace std;
int main()
{
 int n, arr[100];
 int temp, swapped;
 cout << "Enter number of elements: ";
 cin >> n;
 if (n < 1 || n > 100)
 {
 cout << "Invalid number of
elements!";
 return 0;
 }
 cout << "Enter array elements:" <<
endl;
 for (int i = 0; i < n; i++)
 {
 cin >> arr[i];
 }
 for (int i = 0; i < n - 1; i++)
 {
 swapped = 0;
 for (int j = 0; j < n - i - 1; j++)
 {
 if (arr[j] > arr[j + 1])
 {
 temp = arr[j];
 arr[j] = arr[j + 1];
 arr[j + 1] = temp;
 swapped = 1;
 }
 }
 if (swapped == 0)
 {
 break;
 }
 }
 cout << "Sorted array in ascending
order:" << endl;
 for (int i = 0; i < n; i++)
 {
 cout << arr[i] << " ";
 }
Selection Sort
#include <iostream>
using namespace std;
int main()
{
 int n, arr[100];
 int minIndex, temp;
 cout << "Enter number of elements: ";
 cin >> n;
 if (n < 1 || n > 100)
 {
 cout << "Invalid number of
elements!";
 return 0;
 }
 cout << "Enter array elements:" <<
endl;
 for (int i = 0; i < n; i++)
 {
 cin >> arr[i];
 }
 for (int i = 0; i < n - 1; i++)
 {
 minIndex = i;
 for (int j = i + 1; j < n; j++)
 {
 if (arr[j] < arr[minIndex])
 {
 minIndex = j;
 }
 }
 if (minIndex != i)
 {
 temp = arr[i];
 arr[i] = arr[minIndex];
 arr[minIndex] = temp;
 }
 }
 cout << "Sorted array in ascending
order:" << endl;
 for (int i = 0; i < n; i++)
 {
 cout << arr[i] << " ";
 }
 cout << endl;
 return 0;
}
Insertion Sort
#include <iostream>
using namespace std;
int main()
{
 int n, arr[100];
 int key, j;
 cout << "Enter number of elements: ";
 cin >> n;
 if (n < 1 || n > 100)
 {
 cout << "Invalid number of
elements!";
 return 0;
 }
 cout << "Enter array elements:" <<
endl;
 for (int i = 0; i < n; i++)
 {
 cin >> arr[i];
 }
 for (int i = 1; i < n; i++)
 {
 key = arr[i];
 j = i - 1;
 while (j >= 0 && arr[j] > key)
 {
 arr[j + 1] = arr[j];
 j--;
 }
 arr[j + 1] = key;
 }
 cout << "Sorted array in ascending
order:" << endl;
 for (int i = 0; i < n; i++)
 {
 cout << arr[i] << " ";
 }
 cout << endl;
 return 0;
}
 cout << endl;
 return 0;
}
