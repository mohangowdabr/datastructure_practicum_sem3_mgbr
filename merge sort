Merge Sort
#include <iostream>
using namespace std;
void merge(int arr[], int temp[], int low,
int mid, int high)
{
 int i = low;
 int j = mid + 1;
 int k = low;
 // Merge the two sorted halves
 while (i <= mid && j <= high)
 {
 if (arr[i] <= arr[j])
 {
 temp[k] = arr[i];
 i++;
 }
 else
 {
 temp[k] = arr[j];
 j++;
 }
 k++;
 }
 // Copy remaining elements from the
left half
 while (i <= mid)
 {
 temp[k] = arr[i];
 i++;
 k++;
 }
 // Copy remaining elements from the
right half
 while (j <= high)
 {
 temp[k] = arr[j];
 j++;
 k++;
 }
 // Copy merged elements back to the
original array
 for (int i = low; i <= high; i++)
 {
 arr[i] = temp[i];
 }
}
void mergeSort(int arr[], int temp[], int
low, int high)
{
 if (low < high)
 {
 int mid = low + (high - low) / 2;
 // Sort the left half
 mergeSort(arr, temp, low, mid);
 // Sort the right half
 mergeSort(arr, temp, mid + 1, high);
 // Merge both sorted halves
 merge(arr, temp, low, mid, high);
 }
}
int main()
{
 int n;
 int arr[1000], temp[1000];
 cout << "Enter number of elements: ";
 cin >> n;
 if (n < 1 || n > 1000)
 {
 cout << "Invalid number of
elements!";
 return 0;
 }
 cout << "Enter array elements:" <<
endl;
 for (int i = 0; i < n; i++)
 {
 cin >> arr[i];
 }
 cout << "Array before sorting:" << endl;
 for (int i = 0; i < n; i++)
 {
 cout << arr[i] << " ";
 }
 cout << endl;
 mergeSort(arr, temp, 0, n - 1);
 cout << "Array after sorting:" << endl;
 for (int i = 0; i < n; i++)
 {
 cout << arr[i] << " ";
 }
 cout << endl;
 return 0;
}
